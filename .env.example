# Gmail Reader Configuration

# Gmail API
GMAIL_USER=your-email@gmail.com
GMAIL_API_CREDENTIALS=credentials.json

# Translation Service
TRANSLATION_API_KEY=your-google-translate-key
TRANSLATION_SERVICE=google  # Options: google, azure

# Speech Configuration
SPEECH_LANGUAGE=en-US
SPEECH_ENGINE=gtts  # Options: gtts, pyttsx3, azure
SPEECH_RATE=0.9

# Azure Text-to-Speech (optional)
AZURE_SPEECH_KEY=your-azure-key
AZURE_SPEECH_REGION=eastus

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
MAX_EMAILS=10
CACHE_ENABLED=True
CACHE_TTL=3600